{
  "name": "zakai-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "health": "repnix check",
    "health:a11y": "playwright test tests/e2e/guardrails.spec.ts --project=chromium",
    "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then playwright test tests/e2e/guardrails.spec.ts --project=chromium; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
    "health:styles": "stylelint --formatter json \"**/*.{css,pcss,postcss}\""
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "repnix": "^1.1.0",
    "typescript": "^6.0.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
